# NOOA Java - Environment Configuration Example
# Copy this file to .env and configure as needed


# =============================================================================
# OpenAI / LLM Settings
# =============================================================================

# OpenAI API Key (required for non-dummy mode)
# NOTE: no surrounding quotes - dotenv/properties parsing keeps them literally
OPENAI_API_KEY=openrouter_not_needed

# OpenAI Base URL (for OpenAI-compatible endpoints)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Default LLM model
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# Enable the AI chat agent in the MCP Test Client (true/false)
AI_CHAT_ENABLED=true
